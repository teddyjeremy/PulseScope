#include <winver.h>

1 ICON "../../branding/pulsescope.ico"
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0, 4, 0, 0
PRODUCTVERSION 0, 4, 0, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "PulseScope contributors"
            VALUE "FileDescription", "PulseScope performance profiler"
            VALUE "FileVersion", "0.4.0"
            VALUE "InternalName", "PulseScope"
            VALUE "LegalCopyright", "Copyright (c) 2026 PulseScope contributors"
            VALUE "OriginalFilename", "PulseScope.exe"
            VALUE "ProductName", "PulseScope"
            VALUE "ProductVersion", "0.4.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
